# Copie este arquivo para .env e preencha. Nunca publique o .env.

# --- eBay (obrigatório) — developer.ebay.com > Application Keys > Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# --- Critérios
DESCONTO_MINIMO=30          # % abaixo do mercado
VALOR_MERCADO_MINIMO=60     # USD
NOTA_MINIMA=7
NOTA_MAXIMA=10
MIN_COMPARAVEIS=4           # anúncios da mesma carta/nota para calcular a mediana
MAX_BUSCAS_COMPARAVEIS=25   # buscas de comparáveis por rodada (cota do eBay: ~5000 chamadas/dia)
INTERVALO_MINUTOS=15        # usado no modo --loop

# --- Custos para o cálculo de margem
TAXA_EBAY=13                # %
FRETE_REVENDA_USD=10
FRETE_INTERNACIONAL_USD=30
IMPOSTO_IMPORTACAO=60       # %

# --- Alertas no Telegram (recomendado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App no celular (Lovable + Supabase). Veja o prompt-lovable.md
# Supabase > Project Settings > API: "Project URL" e a chave "service_role" (secreta!)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Endereço do seu app no Lovable (vira um botão nas mensagens do Telegram)
LINK_APP=

# --- Alertas por e-mail (Gmail: use uma "senha de app", não sua senha normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Opcionais
# Preço de mercado por vendas concluídas (assinatura paga do PriceCharting)
PRICECHARTING_TOKEN=
# Análise curta do Claude em cada alerta (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
